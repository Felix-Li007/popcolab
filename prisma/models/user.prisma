model User {
  id                   Int                 @id @default(autoincrement())
  clerk_id             String              @unique @db.VarChar(255)
  email                String              @unique @db.VarChar(50)
  user_name            String?             @db.VarChar(50)
  user_type            String              @default("INDIVIDUAL") @db.VarChar(20)
  avatar_image         String?             @db.VarChar(255)
  status               String              @default("active") @db.VarChar(20)
  intake_complete      Boolean             @default(false)
  personality_complete Boolean             @default(false)
  created_at           DateTime            @default(now()) @db.Timestamp(6)
  updated_at           DateTime            @updatedAt @db.Timestamp(6)
  corporate            Company?
  notifications        Notification[]
  orders               Order[]
  profile              Profile?
  requests             Request[]
  created_teams        Team[]              @relation("TeamCreator")
  team_mates           TeamMate[]
  team_invites_sent    TeamInvite[]        @relation("TeamInviter")
  user_vector          UserVector?
  history_preferences  HistoryPreference[]
  user_experiences     UserExperience[]
  user_events          UserEvent[]
  user_preferences     UserPreference[]
  user_personalities   UserPersonality[]

  @@map("user")
}
