model DimensionIndex {
  id                    Int                   @id @default(autoincrement())
  index_key             String?               @db.VarChar(50)
  category_id           Int
  index_name            String                @db.VarChar(50)
  index_notes           String?
  data_type             String                @db.VarChar(20)
  hard_filter           Boolean
  scale_min             Int?
  scale_max             Int?
  penalty_value         Decimal               @default(0.00) @db.Decimal(10, 2)
  created_at            DateTime              @default(now()) @db.Timestamp(6)
  updated_at            DateTime              @updatedAt @db.Timestamp(6)
  dimension_applies     DimensionApply[]
  category              DimensionCategory     @relation(fields: [category_id], references: [id])
  dimension_options     DimensionOption[]
  experience_dimensions ExperienceDimension[]
  questions             Question[]
  question_dimensions   QuestionDimension[]
  request_preferences   RequestPreference[]
  user_personalities    UserPersonality[]
  user_preferences      UserPreference[]

  @@map("dimension_index")
}
