model IntakeForm {
  id                Int      @id @default(autoincrement())
  form_name         String   @db.VarChar(50)
  form_desc         String?  @db.VarChar(255)
  form_status       Int
  form_type         String   @db.VarChar(20)
  created_by        Int
  created_at        DateTime @default(now()) @db.Timestamp(6)
  updated_at        DateTime @updatedAt @db.Timestamp(6)
  creator           User     @relation("IntakeFormCreator", fields: [created_by], references: [id])
  form_questions    FormQuestion[]
  form_dimensions   FormDimension[]

  @@index([created_by], map: "intake_form_created_by_idx")
  @@map("intake_form")
}
