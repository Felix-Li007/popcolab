model QuestionDimension {
  id           Int            @id @default(autoincrement())
  question_id  Int
  dimension_id Int
  weight_rate  Decimal?       @db.Decimal(19, 0)
  created_at   DateTime       @default(now()) @db.Timestamp(6)
  updated_at   DateTime       @updatedAt @db.Timestamp(6)
  dimension    DimensionIndex @relation(fields: [dimension_id], references: [id])

  @@map("question_dimension")
}
