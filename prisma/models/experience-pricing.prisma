model ExperiencePricing {
  id             Int        @id @default(autoincrement())
  experience_id  Int        @unique
  adding_price   Decimal    @default(0) @db.Decimal(19, 0)
  starting_price Decimal    @default(0) @db.Decimal(19, 0)
  starting_hour  Int?
  pricing_model  String?    @db.VarChar(255)
  pricing_notes  String?    @db.VarChar(255)
  created_at     DateTime   @default(now()) @db.Timestamp(6)
  updated_at     DateTime   @updatedAt @db.Timestamp(6)
  experience     Experience @relation(fields: [experience_id], references: [id], onDelete: Cascade)

  @@map("experience_pricing")
}
