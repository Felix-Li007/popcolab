model FormQuestion {
  id          Int       @id @default(autoincrement())
  form_id     Int
  question_id Int
  created_at  DateTime  @default(now()) @db.Timestamp(6)
  updated_at  DateTime  @updatedAt @db.Timestamp(6)
  form        IntakeForm @relation(fields: [form_id], references: [id], onDelete: Cascade)
  question    Question   @relation(fields: [question_id], references: [id], onDelete: Cascade)

  @@unique([form_id, question_id], map: "form_question_form_id_question_id_key")
  @@index([form_id], map: "form_question_form_id_idx")
  @@index([question_id], map: "form_question_question_id_idx")
  @@map("form_question")
}
