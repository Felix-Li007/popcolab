model UserPreference {
    id            Int      @id @default(autoincrement())
    user_id       Int
    question_id   Int
    dimension_id  Int?
    option_id     Int?
    desired_value String   @db.VarChar(255)
    created_at    DateTime @default(now()) @db.Timestamp(6)
    updated_at    DateTime @updatedAt @db.Timestamp(6)

    user            User            @relation(fields: [user_id], references: [id])
    question        Question        @relation(fields: [question_id], references: [id])
    dimension_index DimensionIndex? @relation(fields: [dimension_id], references: [id])
    question_option QuestionOption? @relation(fields: [option_id], references: [id])

    @@index([user_id])
    @@index([dimension_id])
    @@map("user_preference")
}
