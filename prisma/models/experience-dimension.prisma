// ExperienceDimension Model
// This model represents the relationship between experiences and dimensions with scores

model ExperienceDimension {
    id              Int            @id @default(autoincrement())
    experience_id   Int
    dimension_id    Int
    original_score  Int?
    created_at      DateTime       @default(now()) @db.Timestamp()
    updated_at      DateTime       @updatedAt @db.Timestamp()
    experience      Experience     @relation(fields: [experience_id], references: [id])
    dimension_index DimensionIndex @relation(fields: [dimension_id], references: [id])

    @@map("experience_dimension")
}
