model Experience {
  id                     Int                   @id @default(autoincrement())
  provider_id            Int
  category_id            Int
  experience_title       String                @db.VarChar(100)
  popularity_index       Int
  duration_min           Int
  duration_max           Int
  capacity_max           Int
  lead_type              String                @db.VarChar(50)
  delivery_methods       String                @db.VarChar(255)
  dietary_considerations String?               @db.VarChar(255)
  take_item              Int?
  travel_flying          Int?
  created_by             Int
  created_at             DateTime              @default(now()) @db.Timestamp(6)
  updated_at             DateTime              @updatedAt @db.Timestamp(6)
  experience_status      ExperienceStatus      @default(active)
  category               Category              @relation(fields: [category_id], references: [id])
  provider               Provider              @relation(fields: [provider_id], references: [id])
  experience_calendars   ExperienceCalendar[]
  experience_dimensions  ExperienceDimension[]
  experience_images      ExperienceImage[]
  experience_pricing     ExperiencePricing?
  order_items            OrderItem[]
  proposals              Proposal[]
  user_experiences       UserExperience[]

  @@map("experience")
}

enum ExperienceStatus {
  draft
  inactive
  active
}
