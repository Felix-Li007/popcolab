// Experience Model
// This model represents experiences/activities offered by providers

model Experience {
    id                    Int                   @id @default(autoincrement())
    provider_id           Int
    experience_name       String                @db.VarChar(50)
    duration_min          Int
    duration_max          Int
    capacity_max          Int
    starting_price        Decimal               @db.Decimal(19, 0)
    starting_hour         Int
    adding_price          Decimal               @db.Decimal(19, 0)
    lead_type             String                @db.VarChar(50)
    created_at            DateTime              @default(now()) @db.Timestamp()
    updated_at            DateTime              @updatedAt @db.Timestamp()
    provider              Provider              @relation(fields: [provider_id], references: [id])
    experience_dimensions ExperienceDimension[]
    proposals             Proposal[]

    @@map("experience")
}
