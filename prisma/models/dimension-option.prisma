model DimensionOption {
  id            Int            @id @default(autoincrement())
  dimension_id  Int
  allowed_value String         @db.VarChar(100)
  created_at    DateTime       @default(now()) @db.Timestamp(6)
  updated_at    DateTime       @updatedAt @db.Timestamp(6)
  dimension     DimensionIndex @relation(fields: [dimension_id], references: [id])

  @@map("dimension_option")
}
