model DimensionOption {
  id                  Int                 @id @default(autoincrement())
  dimension_id        Int
  option_label        String              @db.VarChar(255)
  option_value        String              @db.VarChar(255)
  penalty_value       Decimal             @default(0.00) @db.Decimal(10, 2)
  created_at          DateTime            @default(now()) @db.Timestamp(6)
  updated_at          DateTime            @updatedAt @db.Timestamp(6)
  dimension_index     DimensionIndex      @relation(fields: [dimension_id], references: [id])
  request_preferences RequestPreference[]

  @@map("dimension_option")
}
