model DimensionApply {
  id              Int            @id @default(autoincrement())
  dimension_id    Int
  form_name       IntakeForm
  created_at      DateTime       @default(now()) @db.Timestamp(6)
  updated_at      DateTime       @updatedAt @db.Timestamp(6)
  dimension_index DimensionIndex @relation(fields: [dimension_id], references: [id], onDelete: Cascade)

  @@index([dimension_id], map: "dimension_apply_dimension_id_idx")
  @@map("dimension_apply")
}
