model Proposal {
  id                  Int        @id @default(autoincrement())
  request_id          Int
  experience_id       Int
  objective_alignment String     @db.VarChar(255)
  base_score          Decimal    @db.Decimal(19, 0)
  risk_adjustment     Decimal    @db.Decimal(19, 0)
  rationale_desc      String     @db.VarChar(255)
  created_at          DateTime   @default(now()) @db.Timestamp(6)
  updated_at          DateTime   @updatedAt @db.Timestamp(6)
  experience          Experience @relation(fields: [experience_id], references: [id])
  request             Request    @relation(fields: [request_id], references: [id])

  @@map("proposal")
}
