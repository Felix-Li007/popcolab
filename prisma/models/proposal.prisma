model Proposal {
  id                   Int                  @id @default(autoincrement())
  request_id           Int
  proposal_status      ProposalStatus       @default(PENDING)
  objective_alignment  String               @db.VarChar(255)
  reject_notes         String?              @db.Text
  created_at           DateTime             @default(now()) @db.Timestamp(6)
  updated_at           DateTime             @updatedAt @db.Timestamp(6)
  orders               Order[]
  proposal_experiences ProposalExperience[]
  request              Request              @relation(fields: [request_id], references: [id])
  user_experiences     UserExperience[]

  @@map("proposal")
}

enum ProposalStatus {
  PENDING
  APPROVED
  ACCEPTED
  REJECTED
}
