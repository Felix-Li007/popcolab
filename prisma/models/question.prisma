model Question {
  id                  Int                 @id @default(autoincrement())
  dimension_id        Int?
  form_name           FormName            @default(REQUEST)
  question_type       String              @db.VarChar(20)
  question_text       String              @db.VarChar(255)
  question_desc       String              @db.VarChar(255)
  created_at          DateTime            @default(now()) @db.Timestamp(6)
  updated_at          DateTime            @updatedAt @db.Timestamp(6)
  order_index         Int?
  dimension_index     DimensionIndex?     @relation(fields: [dimension_id], references: [id])
  question_options    QuestionOption[]
  user_personalities  UserPersonality[]
  user_preferences    UserPreference[]
  request_preferences RequestPreference[]

  @@index([dimension_id])
  @@map("question")
}

enum FormName {
  REQUEST
  MEMBER
  ASSESS
  EXPERIENCE
}
