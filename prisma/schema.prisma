// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/libs/prisma"
}

datasource db {
  provider = "postgresql"
  // provider = "sqlite"
}

model User {
  id         Int      @id @default(autoincrement())
  email      String   @unique @db.VarChar(50)
  name       String?  @db.VarChar(50)
  created_at DateTime @default(now()) @db.Timestamp()
  updated_at DateTime @updatedAt @db.Timestamp()
  profile    Profile?
  corporate  Company?
}

model PersonalityType {
  id               Int      @id @default(autoincrement())
  personality_key  String   @unique @db.VarChar(50)
  personality_name String   @db.VarChar(50)
  personality_desc String?  @db.VarChar(255)
  created_at       DateTime @default(now()) @db.Timestamp()
  updated_at       DateTime @updatedAt @db.Timestamp()

  @@map("Personality_Type")
}

model Profile {
  id                Int       @id @default(autoincrement())
  user_id           Int       @unique
  first_name        String?   @db.VarChar(50)
  last_name         String?   @db.VarChar(50)
  phone_number      String?   @db.VarChar(20)
  preferred_contact String?   @db.VarChar(20)
  consent_given     Int       @db.SmallInt
  privacy_notes     String?   @db.VarChar(255)
  created_at        DateTime? @default(now()) @db.Timestamp()
  updated_at        DateTime  @updatedAt @db.Timestamp()
  user              User      @relation(fields: [user_id], references: [id])
}

model Company {
  id              Int      @id @default(autoincrement())
  user_id         Int      @unique
  corporate_name  String?  @db.VarChar(255)
  department_name String?  @db.VarChar(100)
  role_title      String?  @db.VarChar(50)
  work_mode       String?  @db.VarChar(10)
  created_at      DateTime @default(now()) @db.Timestamp()
  updated_at      DateTime @updatedAt @db.Timestamp()
  user            User     @relation(fields: [user_id], references: [id])
}
