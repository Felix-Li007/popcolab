# Environment variables declared in this file are automatically made available to Prisma.
# See the documentation for more detail: https://pris.ly/d/prisma-schema#accessing-environment-variables-from-the-schema

# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings

NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_IN_FORCE_REDIRECT_URL=/SIGN_IN_FORCE_REDIRECT_URL
NEXT_PUBLIC_CLERK_SIGN_UP_FORCE_REDIRECT_URL=/SIGN_UP_FORCE_REDIRECT_URL
NEXT_PUBLIC_CLERK_ACTION_DASHBOARD_URL=/GOTO_DASHBOARD_URL

# Using the correct DATABASE_URL for development, production and pre-production environments
DATABASE_URL=
# Using 
DIRECT_URL=

# Clerk environment variables for development and production environments
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Cleark secret key for development and production environments
CLERK_SECRET_KEY=

# Stripe
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Stripe webhook signing secret for /api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=

# Clerk webhook signing secret — get from Clerk Dashboard > Webhooks > your endpoint
# Subscribe to: user.updated, user.deleted
CLERK_WEBHOOK_SIGNING_SECRET=

# Upstash QStash
# Webhook path that QStash calls on this app
QSTASH_ENDPOINT_PATH="/api/qstash"
# Server-side publish token from Upstash QStash console
QSTASH_TOKEN=
# Signing keys used to verify incoming QStash webhook deliveries
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# Supabase / Postgres queue name used by PGMQ for proposal generation jobs
SUPABASE_QUEUE_NAME="popcolab-queue"

# Resend API key for sending emails
RESEND_API_KEY=
RESEND_FROM_EMAIL=
NEXT_PUBLIC_APP_URL=http://localhost:3000

TEST_USER_EMAIL=
TEST_USER_PASSWORD=

NEXT_PUBLIC_SUPABASE_URL=https://mqxikeqxarstlkolsmyo.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=sb_publishable_gp2RC9WRHv5aa_YKc8jJEA_MBdswi3d